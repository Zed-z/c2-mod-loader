#include <windows.h>
#include "ModApi.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "Name", "Camera+"
            VALUE "Author", "Zed-z"
            VALUE "Description", "Adds extra camera modes.\n\nOrbit Camera:\nA manually controllable orbiting camera. Use side step controls to tilt left/right and inventory controls to tilt up/down. Optionally turns as you move.\n\nFreecam:\nA camera detached from the player character that can pass through objects. Move around with movement controls. Use side step controls to tilt left/right and inventory controls to tilt up/down. Jump to raise and attack to lower the camera.\n\nChange camera modes with [side step left] + [side step right] + [camera center / 180]."
            VALUE "Version", "1.1.0"
            VALUE "Hyperlink", "https://github.com/Zed-z/c2-mod-loader"
            VALUE "ApiVersion", API_VERSION_STR
            VALUE "ConfigTypes", "General/CameraMode:enum[Normal|Orbit|Freecam]=0,OrbitCamera/InvertX:bool=0,OrbitCamera/InvertY:bool=0,OrbitCamera/AutoTurn:bool=1,OrbitCamera/AutoTurnStrength:int=40,OrbitCamera/AutoTurnMinSpeed:int=100,Freecam/InvertX:bool=0,Freecam/InvertY:bool=0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
