#include <windows.h>
#include "ModApi.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "Name", "Render Extender"
            VALUE "Author", "Zed-z"
            VALUE "Description",
                "Allows you to increase the game's render distance past its limits.\n"
                "\n"
                "Toggle with [F1]. Decrease and increase the render multiplier with [-] / [+].\n"
                "\n"
                "Additionally, these can be configured via the menu bar.\n"
            VALUE "Version", "1.0.0"
            VALUE "Hyperlink", "https://zed-z.github.io/c2-mod-loader/mods#render-extender"
            VALUE "ApiVersion", API_VERSION_STR
            VALUE "ConfigTypes",
                "@Config[General Configuration|General mod settings];"
                "Config/Enabled[Enabled|Enable or disable render distance extension]:bool=1;"
                "Config/RenderMultiplier[Render Multiplier|The amount to multiply the render distance by]:int=3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
