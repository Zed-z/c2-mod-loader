{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "gameVersion",
            "type": "pickString",
            "description": "Select Croc2 version to launch",
            "options": ["US", "EU", "DEMO"],
            "default": "US"
        }
    ],
    "configurations": [
        {
            "name": "Release",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Croc2/${input:gameVersion}/Croc2.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Croc2/${input:gameVersion}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "Build and Deploy (Release - ${input:gameVersion})"
        },
        {
            "name": "Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Croc2/${input:gameVersion}/Croc2.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Croc2/${input:gameVersion}",
            "environment": [],
            "console": "integratedTerminal",
            "symbolSearchPath": "${workspaceFolder}\\build\\Debug",
            "preLaunchTask": "Build and Deploy (Debug - ${input:gameVersion})",
            "logging": {
                "moduleLoad": true
            }
        }
    ]
}
